# =============================================================================
# PixRock VFX Academy — Apache / LiteSpeed configuration for Hostinger
#
# This file is copied verbatim into dist/ by Vite and must sit next to
# index.html in public_html on the server.
#
# IF THE SITE RETURNS 500 INTERNAL SERVER ERROR, the cause is almost always a
# directive this host does not allow. Every block below is guarded by
# <IfModule> so that should not happen — but to isolate it, replace this whole
# file with just these four lines, which are all the site strictly needs:
#
#   RewriteEngine On
#   RewriteCond %{REQUEST_FILENAME} -f [OR]
#   RewriteCond %{REQUEST_FILENAME} -d
#   RewriteRule ^ - [L]
#   RewriteRule ^ index.html [L]
#
# If that works, add the sections below back one at a time.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SPA routing: serve index.html for any path that is not a real file.
#    Without this, refreshing /courses/compositing returns the host's own 404
#    instead of the app.
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Force HTTPS ---------------------------------------------------------
  # DISABLED BY DEFAULT ON PURPOSE. Turn HTTPS on in hPanel instead
  # (Websites → Security → SSL, then "Force HTTPS"), which is safer.
  #
  # Enabling the rule below before the certificate is active — or on a host
  # that terminates TLS at a proxy without setting these variables — produces
  # an infinite redirect loop (ERR_TOO_MANY_REDIRECTS) and the site stops
  # loading entirely. Only uncomment once HTTPS is confirmed working.
  #
  # RewriteCond %{HTTPS} !=on
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Never rewrite existing files or directories (assets, robots.txt, sitemap).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is handled by the React router.
  RewriteRule ^ index.html [L]
</IfModule>

# -----------------------------------------------------------------------------
# 2. Compression
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2 application/font-woff2
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# -----------------------------------------------------------------------------
# 3. Caching. Vite fingerprints filenames under /assets, so those are immutable.
#    index.html must never be cached or visitors get a stale app shell.
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2|webp|avif|svg|png|jpe?g)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(?:html|json|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # ---------------------------------------------------------------------------
  # 4. Security headers
  # ---------------------------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always unset X-Powered-By
</IfModule>

# -----------------------------------------------------------------------------
# 5. MIME types some shared hosts still miss
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# -----------------------------------------------------------------------------
# 6. Hardening: block dotfiles and source maps.
#    Guarded both ways — bare Apache 2.4 "Require" syntax on a 2.2 server, or
#    2.2 "Order/Deny" on 2.4 without mod_access_compat, returns 500.
# -----------------------------------------------------------------------------
# The enquiry configuration holds database credentials. It should live above
# public_html; if it cannot, this stops it being served directly.
<Files "enquiry-config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    <IfModule mod_authz_host.c>
      Order allow,deny
      Deny from all
    </IfModule>
  </IfModule>
</Files>

<FilesMatch "(^\.|\.(env|map|log|bak|sql)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    <IfModule mod_authz_host.c>
      Order allow,deny
      Deny from all
    </IfModule>
  </IfModule>
</FilesMatch>

# Disable directory listings. Guarded because some hosts forbid Options in
# .htaccess (AllowOverride), which would 500 the whole site.
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
