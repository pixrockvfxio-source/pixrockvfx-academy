# =============================================================================
# PixRock VFX Academy — public configuration
#
# Copy to `.env` for local development and `.env.production` for the build you
# upload to Hostinger, then fill in the confirmed values.
#
# SECURITY: every VITE_* variable is INLINED INTO THE PUBLIC JAVASCRIPT BUNDLE
# at build time. Anyone can read them in the browser. Put ONLY public values
# here. Never put SMTP passwords, database credentials, CRM/Zoho tokens, API
# keys or any other secret in this file — those belong on a server, behind the
# endpoint referenced by VITE_ENQUIRY_ENDPOINT.
#
# Leave a variable blank and the UI degrades honestly: it shows a
# "coming soon" note instead of inventing a phone number or a dead link.
# =============================================================================

# Absolute origin of the live site. Used for canonical URLs, Open Graph tags
# and the generated sitemap. No trailing slash.
VITE_SITE_URL=https://www.pixrockvfx.com

# --- Contact details ---------------------------------------------------------
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=

# WhatsApp number, digits only, including country code (e.g. 919000000000).
# Enables the floating "Chat with us" button and the WhatsApp CTA on Contact.
VITE_WHATSAPP_NUMBER=

# --- Campus address ----------------------------------------------------------
VITE_ADDRESS_LINE1=
VITE_ADDRESS_LINE2=
VITE_ADDRESS_CITY=
VITE_ADDRESS_STATE=
VITE_ADDRESS_POSTCODE=
VITE_ADDRESS_COUNTRY=India

# Google Maps embed URL: open Maps → Share → Embed a map → copy only the
# value of the iframe's src attribute and paste it here.
VITE_MAP_EMBED_URL=

# --- Enquiry handling --------------------------------------------------------
# HTTPS endpoint that receives the enquiry form as JSON. This must be a server
# route or form service you control; mail credentials and CRM tokens live
# there, never in this file.
#
# Leave blank to run the form in preview mode: it validates and confirms in the
# browser and transmits nothing, so the site can go live before the backend does.
VITE_ENQUIRY_ENDPOINT=

# --- Social profiles (full URLs) ---------------------------------------------
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_YOUTUBE=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_FACEBOOK=
